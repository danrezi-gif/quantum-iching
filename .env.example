ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Leave disabled until the Ko-fi product, webhook, persistent storage
# and one genuine end-to-end purchase have all been configured.
PAID_ENABLED=false

# Exact link to your $9 / 5-reading Ko-fi Shop product.
KOFI_CHECKOUT_URL=
# From Ko-fi > Settings > Webhooks (never commit actual secret).
KOFI_WEBHOOK_TOKEN=
# The "direct_link_code" of that specific Ko-fi Shop item.
KOFI_PRODUCT_CODE=

# Persistent writable local directory on a SINGLE server instance.
# Not suitable for serverless/ephemeral/multiple-replica deployments.
DATA_DIR=
PORT=5002
